# Copy to .env and fill in. Never share or commit .env.
#
# This is ALL the worker needs: its own login to the Frappe control panel
# (learn.truthofbible.org), for an API user with ONLY the "TOB Social Worker" role.
# Everything else comes from Frappe on every run:
#   - Meta Page token, Page/Instagram IDs  -> TOB Meta Connection
#   - Slack bot token, time zone, settings -> TOB Blessing Automation Settings
FRAPPE_URL=https://learn.truthofbible.org
FRAPPE_API_KEY=
FRAPPE_API_SECRET=
