# Copy to .env and fill in. Never share or commit .env.

# Meta — Facebook Page + linked Instagram
FB_PAGE_ID=1153713644500338
# Page access token (from /me/accounts using a long-lived user token -> never expires)
FB_PAGE_ACCESS_TOKEN=

# Frappe control panel (learn.truthofbible.org) — API key of a user with ONLY the "TOB Social Worker" role
FRAPPE_URL=https://learn.truthofbible.org
FRAPPE_API_KEY=
FRAPPE_API_SECRET=

# Slack bot for approval previews (scopes: chat:write, files:write). The channel is set in the control panel.
SLACK_BOT_TOKEN=

# Decides which calendar day it is, and the post time's zone
TIMEZONE=Asia/Kolkata

# Only used by the manual post_blessing.py command; the scheduled worker takes these from the control panel
APP_LINK=
HASHTAGS=#TruthOfBible #BibleVerse #DailyBlessing #GodBlessYou
DESIGN=modern_mono
PLATFORMS=facebook,instagram
